<?xml version="1.0" encoding="UTF-8"?>
<!-- Example 01's own Maven build: the app. Nothing outside this folder is needed.
     ./mvnw verify                  tests
     docker build -t jvm-args-app:1.0.0 .   the image (see Dockerfile) -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>jvm-args-example</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <description>Example 01: one image, different JVM flags per environment</description>

    <modules>
        <module>app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <archunit.version>1.5.1</archunit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
