# syntax=docker/dockerfile:1
#
# Final image of the workload-training pipeline (training-pipeline.sh, step 6):
#
#   eclipse-temurin:25-jre
#   └─ workload-app:untrained          <- BASE: the image training-pipeline.sh ran with -XX:AOTCacheOutput
#      └─ workload-app:workload-trained   <- this file: + app.aot, nothing else
#
# BASE must be the EXACT image that was trained. The JVM only accepts a cache recorded with the same JDK
# build and the same /app files (down to their sizes and timestamps); otherwise it warns and runs without it.
# Building on top of the trained image guarantees that. In a real pipeline pass it by digest
# (--build-arg BASE=registry/workload-app@sha256:...), so a moved tag can't swap in a different build.
#
# Only app.aot is added: no training data, credentials or tools from the training run end up in the image.
# The entrypoint (java -XX:AOTCache=/app/app.aot ...) and the prod JDK_JAVA_OPTIONS are inherited from BASE.
#
# Build context: a directory that contains only app.aot.
#   docker build -f Dockerfile.trained --build-arg BASE=workload-app:untrained -t workload-app:workload-trained <dir>

ARG BASE
FROM ${BASE}
COPY app.aot /app/app.aot

ARG REVISION=unknown
ARG CREATED=unknown
LABEL org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      com.example.aot.training="workload (examples/06-training-workload/run-workload.sh)"
